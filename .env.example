# Smart AI Assistant — configuration (copy to backend/.env and edit).
# Every setting is an environment variable with the SAA_ prefix; nested groups use "__".
# Secrets here are read by the backend only and are never sent to the browser or written to logs.

# ---- Runtime -----------------------------------------------------------------------------------
SAA_ENV=dev                      # dev | test | prod  (prod REQUIRES SAA_SECURITY__API_TOKEN)
SAA_HOST=127.0.0.1               # keep on loopback: this API controls your computer
SAA_PORT=8000
SAA_LOG_LEVEL=INFO
SAA_LOG_JSON=true

# ---- Security ----------------------------------------------------------------------------------
# Bearer token for the API/UI. Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# SAA_SECURITY__API_TOKEN=
# Browser origins allowed to call the API / open WebSockets (the Vite dev server and the bundled UI)
SAA_SECURITY__ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
SAA_SECURITY__ALLOWED_HOSTS=["localhost","127.0.0.1"]
# Withhold (rather than just flag) tool output containing high-severity prompt-injection patterns
SAA_SECURITY__BLOCK_ON_INJECTION=false
# Listen on a non-loopback address. Off by default: the API controls this computer and has no TLS.
SAA_SECURITY__ALLOW_REMOTE_BIND=false

# ---- LLM (provider-agnostic; YOU choose provider and model, nothing is hard-coded) ---------------
# provider: openai | anthropic | gemini | openrouter | openai_compatible | none   (python -m app providers)
SAA_LLM__PROVIDER=anthropic
SAA_LLM__MODEL=claude-sonnet-5-5
SAA_LLM__TEMPERATURE=0.0
SAA_LLM__MAX_TOKENS=4096
# Key can also come from OPENAI_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY (or GOOGLE_API_KEY) / OPENROUTER_API_KEY
# SAA_LLM__API_KEY=
# openai_compatible (Ollama, vLLM, LM Studio, Azure/other gateways) REQUIRES a base URL; the key is optional
# SAA_LLM__BASE_URL=http://localhost:11434/v1
# OpenRouter attribution headers (optional)
# SAA_LLM__APP_NAME=Smart AI Assistant
# SAA_LLM__APP_URL=
# Override what the registry assumes about a model, e.g. {"supports_vision": true, "supports_json_schema": false}
# SAA_LLM__CAPABILITIES={}
# Prices are ESTIMATES used for cost accounting (USD per 1M tokens)
SAA_LLM__PRICE_INPUT_PER_MTOK=3.0
SAA_LLM__PRICE_OUTPUT_PER_MTOK=15.0

# ---- Web search (used by the web_search tool and as the fallback when a site shows a bot check) ----
# Providers are tried in this order; keyed providers without a key are skipped. duckduckgo needs no key (best effort).
# Keys come from the secret chain, e.g. BRAVE_API_KEY / TAVILY_API_KEY (environment or Windows Credential Manager).
SAA_SEARCH__PROVIDERS=["brave","tavily","duckduckgo"]
SAA_SEARCH__MAX_RESULTS=8
SAA_SEARCH__TIMEOUT_S=15
# Domains whose https pages may be reported as an "official" source without the request naming them,
# e.g. ["spring.io","python.org"]. Empty: only domains the task itself asks for are checked.
SAA_SEARCH__TRUSTED_DOMAINS=[]

# ---- Secret lookup (when keys are not set above) ------------------------------------------------
SAA_SECRETS__PROVIDER=env        # env | keyring (Windows Credential Manager; pip install keyring)
SAA_SECRETS__KEYRING_SERVICE=smart-ai-assistant

# ---- Vision (fallback only; never used unless the agent explicitly asks) -----------------------
SAA_VISION__ENABLED=true
SAA_VISION__PROVIDER=anthropic   # anthropic | openai | none
SAA_VISION__MODEL=claude-sonnet-5-5
SAA_VISION__MIN_CONFIDENCE=0.6   # below this the agent must not act on a vision result

# ---- Database ----------------------------------------------------------------------------------
# PostgreSQL (docker compose -f infra/docker/docker-compose.yml up -d). "memory://" = nothing persisted.
SAA_DATABASE__URL=postgresql+asyncpg://saa:saa@localhost:5432/saa
SAA_DATABASE__AUTO_MIGRATE=false  # true: run `alembic upgrade head` at startup (convenient for single-user installs)

# ---- Filesystem policy -------------------------------------------------------------------------
# The ONLY places the agent may read/write. Empty = Desktop, Downloads, Documents + the workspace.
SAA_FILESYSTEM__ALLOWED_ROOTS=[]
SAA_FILESYSTEM__READ_ONLY_ROOTS=[]
# SAA_FILESYSTEM__WORKSPACE=
SAA_FILESYSTEM__MAX_READ_BYTES=2097152
SAA_FILESYSTEM__MAX_WRITE_BYTES=10485760

# ---- Browser -----------------------------------------------------------------------------------
SAA_BROWSER__HEADLESS=true
# SAA_BROWSER__CHANNEL=            # chrome | msedge to use an installed browser (otherwise bundled Chromium, then Chrome/Edge)
SAA_BROWSER__MAX_TABS=8
SAA_BROWSER__ALLOW_PRIVATE_NETWORK=false   # SSRF guard: block localhost/10.x/192.168.x/169.254.x
SAA_BROWSER__ALLOW_UPLOAD=false
SAA_BROWSER__MAX_DOWNLOAD_BYTES=209715200

# ---- Terminal ----------------------------------------------------------------------------------
SAA_TERMINAL__DEFAULT_TIMEOUT_S=60
SAA_TERMINAL__MAX_TIMEOUT_S=600
SAA_TERMINAL__ALLOW_SHELL_INTERPRETERS=false   # keep false: cmd/powershell/bash are denied
SAA_TERMINAL__MAX_MEMORY_MB=0                  # memory cap for a command and its children (0 = none)
SAA_TERMINAL__MAX_PROCESSES=0                  # cap on processes a command may have at once (0 = none)
SAA_TERMINAL__EXTRA_ALLOWED_PROGRAMS=[]        # extra programs permitted ONLY with explicit approval

# ---- Desktop (Windows UI Automation) -----------------------------------------------------------
SAA_DESKTOP__ENABLED=true
SAA_DESKTOP__MAX_TREE_DEPTH=12             # UWP apps (Calculator, Settings) nest controls deeply
SAA_DESKTOP__MAX_TREE_ELEMENTS=150
SAA_DESKTOP__ALLOW_COORDINATE_FALLBACK=true

# ---- Execution limits (per task) ---------------------------------------------------------------
SAA_LIMITS__MAX_EXECUTION_SECONDS=1800
SAA_LIMITS__MAX_ACTIONS=200
SAA_LIMITS__MAX_LLM_CALLS=60
SAA_LIMITS__MAX_VISION_CALLS=10
SAA_LIMITS__MAX_RETRIES_PER_STEP=3
SAA_LIMITS__MAX_REPLANS=2
SAA_LIMITS__MAX_SHELL_OPERATIONS=40
SAA_LIMITS__MAX_ADAPTIVE_ITERATIONS=12
SAA_LIMITS__APPROVAL_TIMEOUT_S=600
# One computer, one agent: tasks queue instead of driving the same desktop concurrently
SAA_LIMITS__MAX_CONCURRENT_TASKS=1
# Loop protection (secondary safety net; the primary defence is the per-task action ledger)
SAA_LIMITS__MAX_IDENTICAL_ACTIONS=6
SAA_LIMITS__MAX_CYCLE_REPEATS=3
SAA_LIMITS__MAX_NO_PROGRESS=5
# Longest a verification check may poll for a condition (downloads may use up to 30 s)
SAA_LIMITS__VERIFICATION_MAX_WAIT_S=10
